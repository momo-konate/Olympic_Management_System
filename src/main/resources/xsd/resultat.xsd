<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://apiprojet.olympic_management_system/soap"
           targetNamespace="http://apiprojet.olympic_management_system/soap"
           elementFormDefault="qualified">

    <!-- Requête pour récupérer les résultats d'un athlète -->
    <xs:element name="GetHistoriqueAthleteRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="idAthlete" type="xs:long"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- Réponse contenante l'historique des résultats -->
    <xs:element name="GetHistoriqueAthleteResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="resultat" type="tns:ResultatSoapDto" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- Type DTO SOAP pour un résultat -->
    <xs:complexType name="ResultatSoapDto">
        <xs:sequence>
            <xs:element name="idResultat" type="xs:long"/>
            <xs:element name="nomEpreuve" type="xs:string"/>
            <xs:element name="position" type="xs:int" minOccurs="0"/>
            <xs:element name="performance" type="xs:double" minOccurs="0"/>
            <xs:element name="unite" type="xs:string" minOccurs="0"/>
            <xs:element name="medaille" type="xs:string" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

</xs:schema>